# Optional. Struxure ships with analytics disabled.
#
# Set VITE_UMAMI_ID to your own Umami website id to enable privacy-first,
# cookieless analytics on your deployment. Leave it unset — as forks and local
# development should — and no analytics script is injected at all.
VITE_UMAMI_ID=

# Optional. Override only if you self-host Umami.
# Defaults to https://cloud.umami.is/script.js
VITE_UMAMI_SRC=
